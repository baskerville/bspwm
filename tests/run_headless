#!/bin/sh
# Red-green TDD test runner for bspwm
# Usage: ./run_headless
#
# Starts bspwm on a headless X display, runs all tests, reports results.
# Exit code: 0 = all green, 1 = red (failures)

set -e

# The WM exports BSPWM_SOCKET to everything it spawns, so a terminal inside
# a live session carries the live socket path. Left in place, the WM under
# test binds that same path and unlinks it on exit, cutting bspc off from
# the real session.
unset BSPWM_SOCKET
BSPWM="../bspwm"
BSPC="../bspc"
PASS=0
FAIL=0
TESTS_RUN=0

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

cleanup() {
	if [ -n "$BSPWM_PID" ]; then
		kill "$BSPWM_PID" 2>/dev/null || true
		wait "$BSPWM_PID" 2>/dev/null || true
	fi
	if [ -n "$XVFB_PID" ]; then
		kill "$XVFB_PID" 2>/dev/null || true
	fi
}
trap cleanup EXIT

# ---- Start headless display ----

# Find a free display
DISPLAY_NUM=99
while [ -e "/tmp/.X${DISPLAY_NUM}-lock" ]; do
	DISPLAY_NUM=$((DISPLAY_NUM + 1))
done
export DISPLAY=":${DISPLAY_NUM}"

Xvfb "$DISPLAY" -screen 0 1920x1080x24 &
XVFB_PID=$!
sleep 0.5

if ! kill -0 "$XVFB_PID" 2>/dev/null; then
	printf "%b\n" "${RED}FAIL: Xvfb failed to start${NC}"
	exit 1
fi

printf "%b\n" "${YELLOW}=== Testing bspwm on ${DISPLAY} ===${NC}"

# ---- Start bspwm ----

$BSPWM -c /dev/null &
BSPWM_PID=$!
sleep 2

if ! kill -0 "$BSPWM_PID" 2>/dev/null; then
	printf "%b\n" "${RED}FAIL: bspwm failed to start${NC}"
	exit 1
fi

# ---- Test helpers ----

assert_eq() {
	local desc="$1" expected="$2" actual="$3"
	TESTS_RUN=$((TESTS_RUN + 1))
	if [ "$expected" = "$actual" ]; then
		printf "%b\n" "  ${GREEN}PASS${NC}: $desc"
		PASS=$((PASS + 1))
	else
		printf "%b\n" "  ${RED}FAIL${NC}: $desc"
		echo "    expected: '$expected'"
		echo "    actual:   '$actual'"
		FAIL=$((FAIL + 1))
	fi
}

assert_not_empty() {
	local desc="$1" actual="$2"
	TESTS_RUN=$((TESTS_RUN + 1))
	if [ -n "$actual" ]; then
		printf "%b\n" "  ${GREEN}PASS${NC}: $desc"
		PASS=$((PASS + 1))
	else
		printf "%b\n" "  ${RED}FAIL${NC}: $desc (empty)"
		FAIL=$((FAIL + 1))
	fi
}

assert_ok() {
	local desc="$1"
	shift
	TESTS_RUN=$((TESTS_RUN + 1))
	if "$@" >/dev/null 2>&1; then
		printf "%b\n" "  ${GREEN}PASS${NC}: $desc"
		PASS=$((PASS + 1))
	else
		printf "%b\n" "  ${RED}FAIL${NC}: $desc (exit code $?)"
		FAIL=$((FAIL + 1))
	fi
}

assert_fail() {
	local desc="$1"
	shift
	TESTS_RUN=$((TESTS_RUN + 1))
	if ! "$@" >/dev/null 2>&1; then
		printf "%b\n" "  ${GREEN}PASS${NC}: $desc"
		PASS=$((PASS + 1))
	else
		printf "%b\n" "  ${RED}FAIL${NC}: $desc (expected failure, got success)"
		FAIL=$((FAIL + 1))
	fi
}

# ---- TESTS ----

echo ""
echo "== Lifecycle =="

# T1: bspwm is running
assert_ok "bspwm is running" kill -0 "$BSPWM_PID"

# T2: bspc can connect
assert_ok "bspc connects" $BSPC query -M

# T3: at least one monitor exists
MONITORS=$($BSPC query -M 2>/dev/null | wc -l)
assert_not_empty "has monitors" "$MONITORS"

# T4: at least one desktop exists
DESKTOPS=$($BSPC query -D 2>/dev/null | wc -l)
assert_not_empty "has desktops" "$DESKTOPS"

# T5: query --tree returns JSON-like output
TREE=$($BSPC query -T -m 2>/dev/null)
assert_not_empty "query --tree returns data" "$TREE"

# T5b: a second bspwm that resolves THIS socket (via BSPWM_SOCKET) but runs on
# another display must refuse, not unlink the live socket out from under us.
# Regression for the "bspc control dies, keybinds stop" incident.
FIRST_SOCK="${XDG_RUNTIME_DIR:-/tmp}/bspwm_${DISPLAY_NUM}_0-socket"
if [ -S "$FIRST_SOCK" ]; then
	DN2=$((DISPLAY_NUM + 50))
	while [ -e "/tmp/.X${DN2}-lock" ]; do DN2=$((DN2 + 1)); done
	Xvfb ":${DN2}" -screen 0 640x480x24 >/dev/null 2>&1 &
	XVFB2_PID=$!
	sleep 0.5
	BSPWM_SOCKET="$FIRST_SOCK" DISPLAY=":${DN2}" "$BSPWM" -c /dev/null >/dev/null 2>&1 &
	SECOND_PID=$!
	sleep 1
	if kill -0 "$SECOND_PID" 2>/dev/null; then
		printf "%b\n" "  ${RED}FAIL${NC}: second bspwm did not refuse the live socket"
		FAIL=$((FAIL + 1)); kill "$SECOND_PID" 2>/dev/null || true
	else
		printf "%b\n" "  ${GREEN}PASS${NC}: second bspwm refuses the live socket"
		PASS=$((PASS + 1))
	fi
	TESTS_RUN=$((TESTS_RUN + 1))
	assert_ok "live socket survives the second instance" $BSPC query -M
	kill "$XVFB2_PID" 2>/dev/null || true
else
	printf "%b\n" "  ${YELLOW}SKIP${NC}: socket clobber test (socket path not found)"
fi

echo ""
echo "== Desktop operations =="

# T6: create a desktop
assert_ok "add desktop" $BSPC monitor -a test-desktop-1

# T7: desktop shows in query
DCOUNT_AFTER=$($BSPC query -D 2>/dev/null | wc -l)
DCOUNT_EXPECTED=$((DESKTOPS + 1))
assert_eq "desktop count increased" "$DCOUNT_EXPECTED" "$DCOUNT_AFTER"

# T8: switch desktop
assert_ok "focus desktop" $BSPC desktop -f test-desktop-1

# T9: rename desktop
assert_ok "rename desktop" $BSPC desktop -n renamed-desktop

# T10: remove desktop
assert_ok "remove desktop" $BSPC desktop renamed-desktop -r

echo ""
echo "== Keybinding system =="

# T11: add a keybinding
assert_ok "add keybind" $BSPC keybind --add "super + Return" "echo test"

# T12: list keybindings
KB_LIST=$($BSPC keybind --list 2>/dev/null)
assert_not_empty "keybind --list returns data" "$KB_LIST"

# T13: add another
assert_ok "add keybind 2" $BSPC keybind --add "super + q" "bspc node -c"

# T14: remove keybinding
assert_ok "remove keybind" $BSPC keybind --remove "super + Return"

# T15: clear all
assert_ok "clear keybinds" $BSPC keybind --clear

# T16: list is empty after clear
KB_EMPTY=$($BSPC keybind --list 2>/dev/null)
assert_eq "keybinds empty after clear" "" "$KB_EMPTY"

# T16b: keybinds actually FIRE end-to-end (X11 only, needs xdotool).
# This is the only test that exercises the key-press dispatch path, i.e. the
# in-process `bspc ...` fast path in keybind_exec and its fork+sh fallback.
if command -v xdotool >/dev/null 2>&1; then
	# Fast path: a plain `bspc ...` binding runs in-process (no fork/sh).
	$BSPC config border_width 1 >/dev/null 2>&1
	$BSPC keybind --add "super + F12" "bspc config border_width 7" >/dev/null 2>&1
	xdotool key --clearmodifiers super+F12 >/dev/null 2>&1
	sleep 0.3
	BW_FIRED=$($BSPC config border_width 2>/dev/null)
	assert_eq "in-process bspc keybind fires on keypress" "7" "$BW_FIRED"

	# Fallback path: `&&` forces the fork+sh route; the spawned bspc reaches
	# us over the socket (children inherit BSPWM_SOCKET).
	$BSPC keybind --add "super + F11" "bspc config border_width 9 && true" >/dev/null 2>&1
	xdotool key --clearmodifiers super+F11 >/dev/null 2>&1
	sleep 0.3
	BW_FB=$($BSPC config border_width 2>/dev/null)
	assert_eq "fork+sh fallback keybind fires on keypress" "9" "$BW_FB"

	$BSPC keybind --clear >/dev/null 2>&1
else
	printf "%b\n" "  ${YELLOW}SKIP${NC}: keybind firing (needs x11 + xdotool)"
fi

echo ""
echo "== Rule matching (property=pattern) =="

# New-form rule round-trips through `rule -l`.
$BSPC rule -a class=RuleTestA state=floating >/dev/null 2>&1 || true
RL=$($BSPC rule -l 2>/dev/null)
printf '%s\n' "$RL" | grep -q 'class=RuleTestA' && G=yes || G=no
assert_eq "new-form rule round-trips in rule -l" "yes" "$G"

# A regex condition (~=) is preserved verbatim.
$BSPC rule -a 'name~=^RuleRegex.*$' state=floating >/dev/null 2>&1 || true
RL=$($BSPC rule -l 2>/dev/null)
printf '%s\n' "$RL" | grep -q 'name~=\^RuleRegex' && G=yes || G=no
assert_eq "regex rule round-trips in rule -l" "yes" "$G"

# A misspelled key is refused, not silently added.
assert_fail "unknown condition key is rejected" $BSPC rule -a clas=Typo state=floating

# New-form removal: a rule is removed by the exact text `rule -l` prints.
$BSPC rule -a class=RmTest state=floating >/dev/null 2>&1 || true
$BSPC rule -r class=RmTest >/dev/null 2>&1 || true
RL=$($BSPC rule -l 2>/dev/null)
printf '%s\n' "$RL" | grep -q 'class=RmTest' && G=yes || G=no
assert_eq "new-form rule removed by its cause" "no" "$G"

$BSPC rule -r RuleTestA >/dev/null 2>&1 || true
$BSPC rule -r head >/dev/null 2>&1 || true  # drop the regex rule too

# Real window matched by class gets the consequence applied (x11 only:
# the test client sets WM_CLASS; the wl client uses app_id differently).
if [ -f ./test_window ]; then
	$BSPC rule -a class=RuleFloat state=floating >/dev/null 2>&1 || true
	FLOAT_BEFORE=$($BSPC query -N -n .floating 2>/dev/null | wc -l)
	./test_window rulefloat-i RuleFloat &
	RF_PID=$!
	sleep 0.6
	FLOAT_AFTER=$($BSPC query -N -n .floating 2>/dev/null | wc -l)
	assert_eq "class-matched rule floats the window" "$((FLOAT_BEFORE + 1))" "$FLOAT_AFTER"
	kill "$RF_PID" 2>/dev/null || true
	sleep 0.3
	$BSPC rule -r RuleFloat >/dev/null 2>&1 || true
else
	printf "%b\n" "  ${YELLOW}SKIP${NC}: rule window match (needs x11 + test_window)"
fi

echo ""
echo "== Config =="

# T17: get border_width
BW=$($BSPC config border_width 2>/dev/null)
assert_not_empty "config border_width readable" "$BW"

# T18: set and get
assert_ok "set border_width" $BSPC config border_width 3
BW2=$($BSPC config border_width 2>/dev/null)
assert_eq "border_width was set" "3" "$BW2"

# T19: restore
assert_ok "restore border_width" $BSPC config border_width "$BW"

# magnet_threshold: off by default, settable, out-of-range refused.
MT0=$($BSPC config magnet_threshold 2>/dev/null)
assert_eq "magnet_threshold defaults to 0 (off)" "0" "$MT0"
assert_ok "set magnet_threshold" $BSPC config magnet_threshold 16
MT1=$($BSPC config magnet_threshold 2>/dev/null)
assert_eq "magnet_threshold was set" "16" "$MT1"
assert_fail "magnet_threshold rejects out-of-range" $BSPC config magnet_threshold 999
$BSPC config magnet_threshold 0 >/dev/null 2>&1 || true

echo ""
echo "== Window management =="

TEST_CLIENT="./test_window"

if [ -f "$TEST_CLIENT" ]; then
	# -- Spawn first window --
	LEAVES_BEFORE=$($BSPC query -N -n .leaf 2>/dev/null | wc -l)

	$TEST_CLIENT test-a &
	TW1_PID=$!
	sleep 0.5

	LEAVES_AFTER=$($BSPC query -N -n .leaf 2>/dev/null | wc -l)
	LEAVES_EXPECTED=$((LEAVES_BEFORE + 1))
	assert_eq "first window mapped as leaf" "$LEAVES_EXPECTED" "$LEAVES_AFTER"

	# -- Spawn second window (should split) --
	$TEST_CLIENT test-b &
	TW2_PID=$!
	sleep 1

	LEAVES_AFTER2=$($BSPC query -N -n .leaf 2>/dev/null | wc -l)
	LEAVES_EXPECTED2=$((LEAVES_BEFORE + 2))
	assert_eq "second window creates split" "$LEAVES_EXPECTED2" "$LEAVES_AFTER2"

	# -- Focus switching --
	FOCUSED=$($BSPC query -N -n focused 2>/dev/null)
	assert_not_empty "has focused node" "$FOCUSED"

	assert_ok "focus next" $BSPC node -f next.local.leaf
	FOCUSED2=$($BSPC query -N -n focused 2>/dev/null)
	# After focus next, focused node should change (if 2 windows exist)
	if [ "$LEAVES_AFTER2" -ge 2 ]; then
		# We can't guarantee different on all layouts but at least it shouldn't crash
		assert_not_empty "focus next returns a node" "$FOCUSED2"
	fi

	# -- State changes --
	assert_ok "set floating" $BSPC node -t floating
	STATE=$($BSPC query -T -n focused 2>/dev/null | grep -o '"state":"[^"]*"' | head -1)
	assert_eq "node is floating" '"state":"floating"' "$STATE"

	assert_ok "set tiled" $BSPC node -t tiled
	STATE2=$($BSPC query -T -n focused 2>/dev/null | grep -o '"state":"[^"]*"' | head -1)
	assert_eq "node is tiled" '"state":"tiled"' "$STATE2"

	assert_ok "set fullscreen" $BSPC node -t fullscreen
	STATE3=$($BSPC query -T -n focused 2>/dev/null | grep -o '"state":"[^"]*"' | head -1)
	assert_eq "node is fullscreen" '"state":"fullscreen"' "$STATE3"

	assert_ok "back to tiled" $BSPC node -t tiled

	# -- Layer changes --
	# A tiled client is always LAYER_NORMAL: a non-normal layer does nothing
	# while tiling, then decides what you see in monocle, where it outranks
	# focus and covers the focused window unreachably. So the layer only
	# applies to windows that are not part of the layout.
	assert_fail "layer above refused while tiled" $BSPC node -l above
	LAYER=$($BSPC query -T -n focused 2>/dev/null | grep -o '"layer":"[^"]*"' | head -1)
	assert_eq "tiled node stays normal" '"layer":"normal"' "$LAYER"

	assert_ok "float it" $BSPC node -t floating
	assert_ok "set layer above" $BSPC node -l above
	LAYER=$($BSPC query -T -n focused 2>/dev/null | grep -o '"layer":"[^"]*"' | head -1)
	assert_eq "floating node layer is above" '"layer":"above"' "$LAYER"

	assert_ok "back to tiled drops the layer" $BSPC node -t tiled
	LAYER=$($BSPC query -T -n focused 2>/dev/null | grep -o '"layer":"[^"]*"' | head -1)
	assert_eq "layer normalised on tiling" '"layer":"normal"' "$LAYER"

	# -- Flags --
	assert_ok "set sticky" $BSPC node -g sticky=on
	assert_ok "unset sticky" $BSPC node -g sticky=off
	assert_ok "set locked" $BSPC node -g locked=on
	assert_ok "unset locked" $BSPC node -g locked=off
	assert_ok "set marked" $BSPC node -g marked=on
	assert_ok "unset marked" $BSPC node -g marked=off

	# -- Close first window --
	assert_ok "close node" $BSPC node -c
	sleep 0.5

	LEAVES_AFTER3=$($BSPC query -N -n .leaf 2>/dev/null | wc -l)
	LEAVES_EXPECTED3=$((LEAVES_BEFORE + 1))
	assert_eq "leaf removed after close" "$LEAVES_EXPECTED3" "$LEAVES_AFTER3"

	# -- Close second window --
	assert_ok "close last node" $BSPC node -c
	sleep 0.5

	LEAVES_FINAL=$($BSPC query -N -n .leaf 2>/dev/null | wc -l)
	assert_eq "all leaves removed" "$LEAVES_BEFORE" "$LEAVES_FINAL"

	wait "$TW1_PID" 2>/dev/null || true
	wait "$TW2_PID" 2>/dev/null || true
else
	printf "%b\n" "  ${YELLOW}SKIP${NC}: $TEST_CLIENT not built (run 'make' in tests/)"
fi

echo ""
echo "== Rules =="

assert_ok "add rule" $BSPC rule -a "Test:*" state=floating
RULES=$($BSPC rule -l 2>/dev/null | wc -l)
assert_not_empty "rule was added" "$RULES"

assert_ok "remove rule" $BSPC rule -r "Test:*:*"

echo ""
echo "== Monitor operations =="

MON_ID=$($BSPC query -M -m focused 2>/dev/null)
assert_not_empty "focused monitor exists" "$MON_ID"

MON_NAME=$($BSPC query -M -m focused --names 2>/dev/null)
assert_not_empty "monitor has name" "$MON_NAME"

# Add multiple desktops
assert_ok "add desk A" $BSPC monitor -a test-A
assert_ok "add desk B" $BSPC monitor -a test-B
assert_ok "add desk C" $BSPC monitor -a test-C

# Switch between them
assert_ok "focus desk A" $BSPC desktop -f test-A
assert_ok "focus desk B" $BSPC desktop -f test-B
assert_ok "focus desk C" $BSPC desktop -f test-C

# Swap desktops
assert_ok "swap desktops" $BSPC desktop test-A -s test-B

# Remove them
assert_ok "remove desk C" $BSPC desktop test-C -r
assert_ok "remove desk B" $BSPC desktop test-B -r
assert_ok "remove desk A" $BSPC desktop test-A -r

echo ""
echo "== Config settings =="

# Test various config options
for setting in window_gap split_ratio border_width; do
	VAL=$($BSPC config $setting 2>/dev/null)
	assert_not_empty "config $setting readable" "$VAL"
done

assert_ok "set window_gap" $BSPC config window_gap 10
WG=$($BSPC config window_gap 2>/dev/null)
assert_eq "window_gap set to 10" "10" "$WG"
assert_ok "restore window_gap" $BSPC config window_gap 6

assert_ok "set split_ratio" $BSPC config split_ratio 0.6
SR=$($BSPC config split_ratio 2>/dev/null)
# split_ratio returns float
assert_not_empty "split_ratio was set" "$SR"
assert_ok "restore split_ratio" $BSPC config split_ratio 0.5

# Boolean configs
for bcfg in borderless_monocle gapless_monocle focus_follows_pointer; do
	assert_ok "get $bcfg" $BSPC config $bcfg
done

# ---- Quit ----

echo ""
echo "== Regressions =="

# Invalid numbers are rejected and leave the setting alone.
MP0=$($BSPC config top_monocle_padding 2>/dev/null)
assert_fail "monocle padding rejects garbage" $BSPC config top_monocle_padding junk
assert_eq "monocle padding unchanged after a bad value" "$MP0" "$($BSPC config top_monocle_padding 2>/dev/null)"
assert_fail "border_width rejects negatives" $BSPC config border_width -1
assert_fail "window_gap rejects out-of-range" $BSPC config window_gap 99999
assert_fail "window_gap rejects trailing junk" $BSPC config window_gap 10abc
assert_fail "pointer_motion_interval rejects negatives" $BSPC config pointer_motion_interval -1
assert_fail "node -v rejects out-of-range" $BSPC node -v 99999 0
assert_fail "ids above 32 bits are rejected" $BSPC query -N -n 0x1ffffffff
assert_fail "quit rejects an exit status above 255" $BSPC quit 300
assert_ok "bspwm still running after bad quit" kill -0 "$BSPWM_PID"

# Requests larger than the old 8 KB single read arrive whole.
LONG_NAMES=$(seq -f 'regression-desktop-%06g' 1 500)
D_BEFORE=$($BSPC query -D | wc -l)
assert_ok "500 desktops in one 13 KB request" $BSPC monitor -a $LONG_NAMES
assert_eq "all 500 desktops were added" "$((D_BEFORE + 500))" "$($BSPC query -D | wc -l)"
for d in $LONG_NAMES; do $BSPC desktop "$d" -r >/dev/null 2>&1; done
assert_eq "long-request desktops removed" "$D_BEFORE" "$($BSPC query -D | wc -l)"

# A client that connects and sends nothing must not block anyone else, and
# a client that never shuts down its write side still gets an answer.
if command -v python3 >/dev/null 2>&1; then
	SOCK_PATH=$($BSPC --print-socket-path)
	IPC_OUT=$(python3 -I - "$SOCK_PATH" "$BSPC" <<'PY'
import socket, subprocess, sys, time
path, bspc = sys.argv[1], sys.argv[2]
stall = socket.socket(socket.AF_UNIX); stall.connect(path)
t = time.time()
ok = subprocess.run([bspc, "query", "-M"], capture_output=True).returncode == 0
print("stall", "ok" if ok and time.time() - t < 1 else "blocked")
s = socket.socket(socket.AF_UNIX); s.connect(path); s.sendall(b"query\0-M\0")
s.settimeout(1); out = b""
try:
    while True:
        d = s.recv(4096)
        if not d: break
        out += d
except socket.timeout:
    pass
print("legacy", "ok" if out.strip() else "noreply")
PY
)
	assert_eq "a stalled client does not block bspc" "stall ok" "$(echo "$IPC_OUT" | grep stall)"
	assert_eq "a client without shutdown(SHUT_WR) gets a reply" "legacy ok" "$(echo "$IPC_OUT" | grep legacy)"
fi

# State loads from a FIFO.
FIFO_DIR=$(mktemp -d)
mkfifo "$FIFO_DIR/state"
$BSPC wm -d > "$FIFO_DIR/dump"
D_BEFORE=$($BSPC query -D | wc -l)
cat "$FIFO_DIR/dump" > "$FIFO_DIR/state" &
FEED_PID=$!
assert_ok "wm -l reads state from a FIFO" $BSPC wm -l "$FIFO_DIR/state"
wait "$FEED_PID"
assert_eq "desktops intact after FIFO restore" "$D_BEFORE" "$($BSPC query -D | wc -l)"
rm -rf "$FIFO_DIR"

echo "== Shutdown =="
assert_ok "bspc quit" $BSPC quit
sleep 0.5
if kill -0 "$BSPWM_PID" 2>/dev/null; then
	printf "%b\n" "  ${RED}FAIL${NC}: bspwm still running after quit"
	FAIL=$((FAIL + 1))
else
	printf "%b\n" "  ${GREEN}PASS${NC}: bspwm exited cleanly"
	PASS=$((PASS + 1))
fi
TESTS_RUN=$((TESTS_RUN + 1))
BSPWM_PID=""

# ---- unit tests (backend-agnostic, no display needed) ----
echo ""
echo "== unit tests =="
for unit in rule_match magnet jsmn geometry; do
	if [ -x "./test_$unit" ]; then
		if "./test_$unit" > "/tmp/bspwm_${unit}_unit.$$" 2>&1; then
			printf "%b\n" "  ${GREEN}PASS${NC}: $unit unit suite"
			PASS=$((PASS + 1))
		else
			printf "%b\n" "  ${RED}FAIL${NC}: $unit unit suite"
			sed 's/^/    /' "/tmp/bspwm_${unit}_unit.$$"
			FAIL=$((FAIL + 1))
		fi
		TESTS_RUN=$((TESTS_RUN + 1))
		rm -f "/tmp/bspwm_${unit}_unit.$$"
	else
		printf "%b\n" "  ${YELLOW}SKIP${NC}: $unit unit suite (not built)"
	fi
done

# ---- Report ----

echo ""
echo "================================="
TOTAL=$((PASS + FAIL))
if [ "$FAIL" -eq 0 ]; then
	printf "%b\n" "${GREEN}ALL GREEN: ${PASS}/${TOTAL} tests passed${NC}"
else
	printf "%b\n" "${RED}RED: ${FAIL} failures, ${PASS} passed out of ${TOTAL}${NC}"
fi
echo "================================="

exit "$FAIL"
